{
  "extends": "@detaileed/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "types": ["node", "vitest/globals"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src", "tests", ".next/types/**/*.ts", "next.config.ts"],
  "exclude": ["node_modules"]
}
