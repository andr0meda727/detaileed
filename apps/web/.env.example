# Copy to .env.local and fill in. NEXT_PUBLIC_* values are built into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Backend origin, without /api (e.g. http://localhost:5174 for a local API); empty = https://api.detaileed.com.
NEXT_PUBLIC_API_URL=
# This site's public origin (sitemap, canonical links, auth redirects); empty = https://detaileed.com.
NEXT_PUBLIC_SITE_URL=
# The studio dashboard (link for studio owners); empty = https://app.detaileed.com.
NEXT_PUBLIC_DASHBOARD_URL=
# MapLibre style for maps; empty = OpenFreeMap (https://tiles.openfreemap.org/styles/liberty).
NEXT_PUBLIC_MAP_STYLE_URL=
