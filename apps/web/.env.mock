# The customer site against the mock API (apps/mock-api), loaded by `pnpm dev:mock` (scripts/dev-mock.mjs puts it
# into the environment, which beats .env.local). Sign in as klient@demo.detaileed.com, password demo1234.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:5180
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=mock-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:5180
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL is set by dev-mock.mjs to http://localhost:<port>.
# No captcha against the mock.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
