# The dashboard against the mock API (apps/mock-api), loaded by `pnpm dev:mock` (vite --mode mock).
# Mode files beat .env.local, so these win over your own settings. Sign in as wlasciciel@demo.detaileed.com
# or pracownik@demo.detaileed.com, password demo1234.
VITE_SUPABASE_URL=http://localhost:5180
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=mock-publishable-key
VITE_API_URL=http://localhost:5180
VITE_WEB_URL=http://localhost:3001
# No captcha against the mock.
VITE_TURNSTILE_SITE_KEY=
