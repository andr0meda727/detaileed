# Copy to .env.local and fill in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Backend origin, without /api (e.g. http://localhost:5174 for a local API).
# Empty = same origin in dev (Vite proxies /api to https://api.detaileed.com) and https://api.detaileed.com in prod.
VITE_API_URL=
# MapLibre style for maps; empty = OpenFreeMap (https://tiles.openfreemap.org/styles/liberty).
VITE_MAP_STYLE_URL=
# Customer site origin, for "see the public page" links; empty = https://detaileed.com.
VITE_WEB_URL=
