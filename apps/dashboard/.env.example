# Copy to .env.local and fill in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Backend origin, without /api (e.g. http://localhost:5174 for a local API).
# Empty = same origin in dev (Vite proxies /api to https://api.detaileed.com) and https://api.detaileed.com in prod.
VITE_API_URL=
