{
  "name": "detaileed",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mock": "turbo run dev:mock",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck && turbo run test && turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@detaileed/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "prettier": "@detaileed/config/prettier"
}
